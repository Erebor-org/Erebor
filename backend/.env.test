# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET=''
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Base de test : conteneur postgres-test (docker compose --profile test up -d postgres-test).
# phpunit.xml.dist force aussi cette valeur, car docker-compose exporte le DATABASE_URL de dev.
DATABASE_URL="postgresql://erebor:erebor@postgres-test:5432/erebor?serverVersion=16&charset=utf8"
